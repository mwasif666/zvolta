  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "glob": "^11.0.0",
    "htmltojsx": "^0.3.0",
    "jsdom": "^27.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
